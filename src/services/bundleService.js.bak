import { addItem } from "./itemService.js";
import { initDatabase } from "../database/init.js";
import {
  getCurrentUser
} from "../firebase/auth.js";

import {
  getUserProfile,
  createBundle,
  getBundlesByShop
} from "../firebase/firestore.js";

export async function addBundle(bundle) {
  const db = await initDatabase();

  const user = getCurrentUser();

  if (!user) {
    throw new Error("User is not logged in");
  }

  const profile = await getUserProfile(user.uid);

  if (!profile) {
    throw new Error("User Profile မတွေ့ပါ");
  }

  const createdAt = Date.now();

  // =========================================
  // 1. Save Bundle to local SQLite
  // =========================================

  const sql = `
    INSERT INTO bundles
    (
      shopId,
      bundleCode,
      bundleName,
      qty,
      cost,
      createdAt
    )
    VALUES (?, ?, ?, ?, ?, ?)
  `;

  const result = await db.run(sql, [
    profile.shopId,
    bundle.bundleCode,
    bundle.bundleName,
    Number(bundle.qty || 0),
    Number(bundle.cost || 0),
    createdAt
  ]);

  const bundleId = result.changes.lastId;

  // =========================================
  // 2. Save Bundle to Firestore
  // =========================================

  try {
    const cloudBundleId =
      `${profile.shopId}_${bundle.bundleCode}`;

    await createBundle(cloudBundleId, {
      shopId: profile.shopId,
      bundleCode: bundle.bundleCode,
      bundleName: bundle.bundleName,
      qty: Number(bundle.qty || 0),
      cost: Number(bundle.cost || 0),
      createdAt
    });

    console.log(
      "CLOUD BUNDLE CREATED:",
      cloudBundleId
    );

  } catch (err) {
    // Offline ဖြစ်နေရင် Local save ကို မဖျက်ပါ
    console.warn(
      "Cloud bundle save failed:",
      err
    );
  }

  // =========================================
  // 3. Generate items
  // =========================================

  const qty = Number(bundle.qty || 0);

  const unitCost =
    qty > 0
      ? Math.floor(Number(bundle.cost || 0) / qty)
      : 0;

  const remainder =
    Number(bundle.cost || 0) -
    (unitCost * qty);

  for (let i = 1; i <= qty; i++) {

    await addItem({
      bundleId,
      itemId:
        bundle.bundleCode +
        String(i).padStart(3, "0"),

      photo: "",

      cost:
        i === qty
          ? unitCost + remainder
          : unitCost,

      price: 0,
      note: ""
    });
  }
}


// =========================================
// GET BUNDLES
// Local + Cloud Sync
// =========================================

export async function getBundles() {
  const db = await initDatabase();

  const user = getCurrentUser();

  if (!user) {
    return [];
  }

  const profile = await getUserProfile(user.uid);

  if (!profile?.shopId) {
    return [];
  }

  // =========================================
  // 1. Try Cloud → Local sync
  // =========================================

  try {
    const cloudBundles =
      await getBundlesByShop(profile.shopId);

    for (const bundle of cloudBundles) {

      const existing = await db.query(
        `
        SELECT id
        FROM bundles
        WHERE shopId = ?
          AND bundleCode = ?
        LIMIT 1
        `,
        [
          profile.shopId,
          bundle.bundleCode
        ]
      );

      if (existing.values?.length) {

        // Update local copy
        await db.run(
          `
          UPDATE bundles
          SET
            bundleName = ?,
            qty = ?,
            cost = ?,
            createdAt = ?
          WHERE id = ?
          `,
          [
            bundle.bundleName,
            Number(bundle.qty || 0),
            Number(bundle.cost || 0),
            bundle.createdAt || Date.now(),
            existing.values[0].id
          ]
        );

      } else {

        // Insert cloud bundle into local SQLite
        await db.run(
          `
          INSERT INTO bundles
          (
            shopId,
            bundleCode,
            bundleName,
            qty,
            cost,
            createdAt
          )
          VALUES (?, ?, ?, ?, ?, ?)
          `,
          [
            profile.shopId,
            bundle.bundleCode,
            bundle.bundleName,
            Number(bundle.qty || 0),
            Number(bundle.cost || 0),
            bundle.createdAt || Date.now()
          ]
        );
      }
    }

  } catch (err) {

    // Offline / network error ဖြစ်ရင်
    // Local SQLite ကိုပဲ ဆက်သုံး
    console.warn(
      "Cloud bundle sync skipped:",
      err
    );
  }

  // =========================================
  // 2. Return local bundles
  // =========================================

  const result = await db.query(
    `
    SELECT *
    FROM bundles
    WHERE shopId = ?
    ORDER BY createdAt DESC
    `,
    [profile.shopId]
  );

  return result.values ?? [];
}


// =========================================
// BUNDLE CODE EXISTS
// =========================================

export async function bundleCodeExists(code) {
  const bundles = await getBundles();

  return bundles.some(
    b =>
      b.bundleCode
        .trim()
        .toUpperCase() ===
      code.trim().toUpperCase()
  );
}


// =========================================
// DELETE BUNDLE
// =========================================

export async function deleteBundle(bundleId) {
  const db = await initDatabase();

  // Items အရင်ဖျက်
  await db.run(
    `DELETE FROM items WHERE bundleId=?`,
    [bundleId]
  );

  // Bundle ဖျက်
  await db.run(
    `DELETE FROM bundles WHERE id=?`,
    [bundleId]
  );
}
