rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helpers
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myShopId() {
      return myProfile().shopId;
    }

    function isAdmin() {
      return hasProfile()
        && myProfile().role == "admin";
    }

    function isStaff() {
      return hasProfile()
        && myProfile().role == "staff";
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // ကိုယ့် profile
      allow get: if signedIn()
        && request.auth.uid == userId;

      // Admin က ကိုယ့် shop ထဲက staff profile ကိုဖတ်နိုင်
      allow list: if isAdmin()
        && resource.data.shopId == myShopId()
        && resource.data.role == "staff";

      // Admin အသစ်ရဲ့ profile
      // UID = shopId = admin UID
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == "admin"
        && request.resource.data.shopId == userId;

      // Admin က staff profile ဖန်တီးနိုင်
      allow create: if isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.role == "staff"
        && request.resource.data.shopId == myShopId();

      // ကိုယ့် profile update
      // role / shopId / uid မပြောင်းနိုင်
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.shopId == resource.data.shopId;

      // Admin က ကိုယ့် shop ထဲက staff ကို update
      allow update: if isAdmin()
        && resource.data.role == "staff"
        && resource.data.shopId == myShopId()
        && request.resource.data.role == "staff"
        && request.resource.data.shopId == myShopId()
        && request.resource.data.uid == resource.data.uid;

      // Client က user profile delete မလုပ်နိုင်
      allow delete: if false;
    }


    // =========================
    // SHOPS
    // =========================

    match /shops/{shopId} {

      // ကိုယ့် shop
      allow get: if signedIn()
        && (
          (
            shopId == request.auth.uid
            && resource.data.adminUid == request.auth.uid
          )
          ||
          (
            hasProfile()
            && myShopId() == shopId
          )
        );

      // Shop name / invite code query
      // Authenticated user များသာ query လုပ်နိုင်
      allow list: if signedIn();

      // Shop အသစ် create
      // shopId = admin UID
      allow create: if signedIn()
        && request.auth.uid == shopId
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.shopName is string
        && request.resource.data.ownerName is string
        && request.resource.data.inviteCode is string;

      // ကိုယ့် shop ကိုပဲ update
      allow update: if isAdmin()
        && myShopId() == shopId
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == resource.data.adminUid;

      // Shop delete ကို client က မလုပ်နိုင်
      allow delete: if false;
    }

// =========================
// BUNDLES
// =========================

match /bundles/{bundleId} {

  allow read: if signedIn()
    && hasProfile()
    && resource.data.shopId == myShopId();

  allow create: if signedIn()
    && hasProfile()
    && request.resource.data.shopId == myShopId();

  allow update: if signedIn()
    && hasProfile()
    && resource.data.shopId == myShopId()
    && request.resource.data.shopId == myShopId();

  allow delete: if signedIn()
    && isAdmin()
    && resource.data.shopId == myShopId();
}


// =========================
// ITEMS
// =========================

match /items/{itemId} {

  allow read: if signedIn()
    && hasProfile()
    && resource.data.shopId == myShopId();

  allow create: if signedIn()
    && hasProfile()
    && request.resource.data.shopId == myShopId();

  allow update: if signedIn()
    && hasProfile()
    && resource.data.shopId == myShopId()
    && request.resource.data.shopId == myShopId();

  allow delete: if signedIn()
    && isAdmin()
    && resource.data.shopId == myShopId();
}

    // =========================
// BACKUPS
// =========================

match /backups/{userId} {

  // Backup metadata
  allow read, write: if signedIn()
    && request.auth.uid == userId;

  // Backup chunks
  match /chunks/{chunkId} {
    allow read, write: if signedIn()
      && request.auth.uid == userId;
  }
}


    // =========================
    // DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
